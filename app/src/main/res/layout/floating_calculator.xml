<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="280dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_floating" android:elevation="8dp" android:padding="12dp">
<LinearLayout android:id="@+id/bubble_head" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#FF5E3A" android:padding="8dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🛵 PeyaCalc - Arrastrame" android:textColor="#fff" android:textStyle="bold"/>
<TextView android:id="@+id/btnClose" android:layout_width="32dp" android:layout_height="32dp" android:text="✕" android:textColor="#fff" android:gravity="center" android:textSize="18sp"/>
</LinearLayout>
<LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍 Dist. Retiro (km)" android:textColor="#a0a0a0" android:textSize="12sp"/>
<EditText android:id="@+id/inputRetiro" android:layout_width="match_parent" android:layout_height="48dp" android:background="#1a1a2e" android:textColor="#fff" android:inputType="numberDecimal" android:hint="Ej: 1.2" android:textColorHint="#666" android:padding="12dp" android:layout_marginBottom="8dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠 Dist. Entrega (km)" android:textColor="#a0a0a0" android:textSize="12sp"/>
<EditText android:id="@+id/inputEntrega" android:layout_width="match_parent" android:layout_height="48dp" android:background="#1a1a2e" android:textColor="#fff" android:inputType="numberDecimal" android:hint="Ej: 3.5" android:textColorHint="#666" android:padding="12dp" android:layout_marginBottom="8dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏰ Franja" android:textColor="#a0a0a0" android:textSize="12sp"/>
<Spinner android:id="@+id/spinnerFranja" android:layout_width="match_parent" android:layout_height="48dp" android:background="#1a1a2e" android:layout_marginBottom="8dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎖 Grupo" android:textColor="#a0a0a0" android:textSize="12sp"/>
<Spinner android:id="@+id/spinnerGrupo" android:layout_width="match_parent" android:layout_height="48dp" android:background="#1a1a2e" android:layout_marginBottom="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<CheckBox android:id="@+id/checkPeak" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔥Peak" android:textColor="#fff" android:buttonTint="#FF5E3A"/>
<CheckBox android:id="@+id/checkLluvia" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🌧Lluvia" android:textColor="#fff" android:buttonTint="#FF5E3A"/>
<CheckBox android:id="@+id/checkDoble" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📦Doble" android:textColor="#fff" android:buttonTint="#FF5E3A"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnCalcular" android:layout_width="match_parent" android:layout_height="52dp" android:text="💰 CALCULAR" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/txtResultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="$0" android:textColor="#00C853" android:textSize="22sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="12dp" android:background="#0f3460" android:padding="12dp"/>
<TextView android:id="@+id/txtDesglose" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#a0a0a0" android:textSize="11sp" android:layout_marginTop="8dp"/>
</LinearLayout>
</LinearLayout>
